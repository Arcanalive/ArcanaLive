/* styles.css */

body {
    font-family: Arial, sans-serif;
    background-color: #1a1a1a;
    color: white;
    margin: 0;
    padding: 0;
}

header {
    background-color: #2c003e;
    padding: 20px;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin-right: 20px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
}

.hero {
    background: linear-gradient(to right, #5b0f9d, #3d0056);
    padding: 50px;
    text-align: center;
}

h1 {
    font-size: 3em;
    margin: 0;
}

h2 {
    text-align: center;
    margin-top: 40px;
}

.service-item {
    background-color: #3d0056;
    margin: 20px;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
}

form {
    background-color: #3d0056;
    padding: 30px;
    border-radius: 8px;
    max-width: 500px;
    margin: 0 auto;
}

form label {
    display: block;
    margin-bottom: 10px;
}

form input, form textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 20px;
    background-color: #2c003e;
    border: none;
    color: white;
    border-radius: 5px;
}

form button {
    background-color: #5b0f9d;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

footer {
    background-color: #2c003e;
    text-align: center;
    padding: 20px;
    margin-top: 50px;
}
